{
  "kata": "s4",
  "description": "Release notes: 2-source fan-out (user-visible changes, fixes/compat/deprecations), join, dedupe, final formatting.",
  "requiredCalls": {
    "Flow.agent": { "min": 2, "max": 2 },
    "Uni.joinAll": { "min": 1, "max": 1 },
