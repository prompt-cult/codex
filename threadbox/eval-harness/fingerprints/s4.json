    "ThreadBox.publish": { "min": 1, "max": 1 }
  },
  "requiredAnyOf": [["Uni.map", "toAgent"]],
  "forbiddenCalls": ["Flow.endpoint"],
  "maxAgentCalls": 3,
  "publishCount": { "min": 1, "max": 1 }
}
