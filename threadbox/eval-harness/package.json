{
  "name": "threadbox-eval-harness",
  "version": "0.0.0",
  "private": true,
  "description": "ThreadBox Phase 1 promptfoo kata harness (providers x katas x graders). Pins promptfoo separately from sdk/package.json's assemblyscript pin -- these two toolchains evolve on independent schedules.",
  "type": "module",
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "scripts": {
    "prepare": "npm --prefix ../sdk install --no-audit --no-fund",
    "test": "node --test providers/*.test.mjs",
    "smoke": "node providers/smoke.mjs",
    "smoke:zen-protocols": "node providers/zen-protocol-smoke.mjs",
    "eval": "npm run eval:eco",
    "eval:eco": "THREADBOX_PROFILE=eco promptfoo eval -c promptfooconfig.yaml --no-cache",
    "eval:performance": "THREADBOX_PROFILE=performance promptfoo eval -c promptfooconfig.yaml --no-cache",
    "view": "promptfoo view"
  },
  "dependencies": {
    "js-yaml": "5.2.1",
    "promptfoo": "0.121.19"
  }
}
