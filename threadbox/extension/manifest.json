{
  "manifest_version": 3,
  "name": "ThreadBox Browser Runtime",
  "version": "0.0.0",
  "description": "Pre-alpha browser WebAssembly runtime chassis.",
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
