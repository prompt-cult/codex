#!/bin/sh
# A fake `codex` binary for tb-design's CI-safe smoke test. Reads the
# target path and attempt number tb-design passes via environment
# variables (real codex exec would learn the target from the prompt
# text instead; these env vars exist purely so this stub needs no
# prompt-parsing to behave deterministically). Attempt 1 writes a
# program with a type error; attempt 2 onward writes a valid one, so
# the smoke test exercises one failure and one convergence.
set -e
target="$TB_DESIGN_TARGET"
attempt="$TB_DESIGN_ATTEMPT"

if [ "$attempt" = "1" ]; then
  cat > "$target" <<'EOF'
export function main(): void {
  const x: string = 42;
}
EOF
else
  cat > "$target" <<'EOF'
export function main(): void {}
EOF
fi
