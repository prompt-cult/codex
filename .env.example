# Example environment for running this fork with an isolated configuration.
# Copy to `.env` and fill in real values. The CLI loads `.env` at startup via
# dotenvy before reading any configuration.
#
# NOTE: CODEX_CONFIG_DIR / CODEX_HOME are intentionally NOT honored from
# `.env` — they must be exported in the real process environment. A `.env`
# file in an untrusted directory (e.g. a cloned repo) must not be able to
# silently redirect config, auth tokens, and history to another location:
#
#   export CODEX_CONFIG_DIR=~/.codex-mistral

# API key for the Mistral translating proxy (codex mistral-proxy). Pipe it to
# the proxy on stdin, e.g.:
#   grep '^MISTRAL_API_KEY=' .env | cut -d= -f2 | codex mistral-proxy --port 8901
MISTRAL_API_KEY=your-mistral-api-key-here
